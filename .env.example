# Copy this file to `.env` for local dev:  cp .env.example .env
# `.env` is gitignored — real values NEVER get committed.
#
# Railway injects PORT automatically, so you don't set it there.
# Locally, the server falls back to 8080 if PORT is unset.

PORT=8080

# NODE_ENV controls security hardening in server/index.js.
# Use "production" when deployed. Railway sets this for you on most templates,
# but setting it explicitly in the Railway dashboard is a good habit.
NODE_ENV=development
